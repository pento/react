{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.5",
    "wp": "latest"
  },
  "landingPage": "/?name=react-plugin-demo",
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/pento/react",
        "ref": "master",
        "refType": "branch"
      },
      "options": {
        "targetFolderName": "react"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire_once '/wordpress/wp-load.php';\nrequire_once '/wordpress/wp-content/plugins/react/tools/seed-playground-data.php';\n"
    }
  ]
}

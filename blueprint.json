{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.5",
    "wp": "latest"
  },
  "landingPage": "/?name=react-plugin-demo",
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installPlugin",
      "pluginZipFile": {
        "resource": "url",
        "url": "https://github.com/georgestephanis/react/archive/refs/heads/update/wp-7.1.zip"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire_once '/wordpress/wp-load.php';\n$plugin_dirs = glob( WP_PLUGIN_DIR . '/react*' );\nif ( ! empty( $plugin_dirs ) ) {\n\trequire_once $plugin_dirs[0] . '/tools/seed-playground-data.php';\n}\n"
    }
  ]
}

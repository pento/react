<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for React Plugin">
	<description>PHP CodeSniffer ruleset for the Reactions (React) plugin.</description>

	<!-- What to scan -->
	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/tests/bootstrap.php</exclude-pattern>
	<exclude-pattern>/tests/class-wp-test-*</exclude-pattern>
	<exclude-pattern>/tools/compile_emoji.php</exclude-pattern>

	<!-- How to scan -->
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- Rulesets to use -->
	<rule ref="WordPress-Core" />
	<rule ref="WordPress-Docs" />
	<rule ref="WordPress-Extra" />

	<!-- Test methods are self-documenting by name; don't require a docblock on every one. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
